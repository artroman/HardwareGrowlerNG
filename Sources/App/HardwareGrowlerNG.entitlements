<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardware monitoring (IOKit matching, SystemConfiguration, global event
	     taps) does not work well under the App Sandbox, so it is disabled.
	     Revisit if this is ever distributed through the Mac App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
